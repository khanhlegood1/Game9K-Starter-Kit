# ============================================================================
# Game9K Starter Kit — Environment Configuration (.env.example)
# Copy to `.env` for local overrides. Never commit real secrets!
# ============================================================================

# Server bind host & port (0.0.0.0 required for Docker / Cloud / Live Preview)
HOST=0.0.0.0
PORT=3000

# Optional: TikTok Session ID & Target IDC (only needed if TikTok rate-limits anonymous connections)
TIKTOK_SESSION_ID=
TIKTOK_TARGET_IDC=

# Optional: YouTube Data API v3 Key (falls back to zero-key InnerTube live_chat polling if omitted)
YOUTUBE_API_KEY=

# Optional: Game9K Portal / Supabase Configuration (for G2/G1 connected portal deployment)
SUPABASE_URL=
SUPABASE_ANON_KEY=
GAME9K_PORTAL_ORIGIN=https://game9k.com

# Optional: Gemini Decisions API Key (model `gemini-decision-1` for `/decisions.html` & `npm run decide`;
# falls back to the built-in Game9K Calibrated Decisions Engine when omitted)
GEMINI_API_KEY=

# Optional: Xsolla SDK 3 Publisher Account Credentials (`https://publisher.xsolla.com`)
# When omitted, Game9K runs the full zero-account Xsolla SDK 3 Sandbox (`01 Auth -> 02 Catalog -> 03 Pay Station -> 04 Finalize`)!
XSOLLA_PROJECT_ID=249001
XSOLLA_LOGIN_ID=026201e3-7e40-4784-b61b-a75979884924
XSOLLA_MERCHANT_ID=
XSOLLA_API_KEY=
XSOLLA_WEBHOOK_SECRET=

