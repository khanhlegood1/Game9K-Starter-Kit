{
  "schema_version": 1,
  "id": "starter-template",
  "title": "Game9K Minimal Canvas, PokiSDK & Xsolla SDK 3 Boilerplate",
  "version": "2.0.0",
  "description": "Clean <10KB HTML5 Canvas boilerplate wired to Game9K SDK v2.0, Poki Portal Lifecycle, Xsolla SDK 3 Storefront, and TikTok/YouTube Live StreamBridge.",
  "author": "Game9K Studio",
  "entry": "index.html",
  "legal_classification": "G4",
  "supported_modes": ["G4", "G2", "G1"],
  "budgets": {
    "max_gzip_kb": 60,
    "target_fps": 60
  },
  "bridge": {
    "sandbox_compatible": true,
    "requires_same_origin": false,
    "poki_sdk_compatible": true,
    "max_telemetry_hz": 10,
    "events_emitted": [
      "game_ready",
      "poki_loading_finished",
      "poki_gameplay_start",
      "realtime_broadcast_tick",
      "leaderboard_submit",
      "xsolla_purchase_finalized"
    ]
  },
  "ads": {
    "provider": "poki-portal-and-google-h5",
    "placements": ["commercialBreak", "rewardedBreak"],
    "preroll_timeout_ms": 2000
  },
  "monetization": {
    "provider": "xsolla-sdk-3",
    "sandbox_supported": true,
    "products": ["sanctuary_vip_pass"]
  },
  "stream": {
    "platforms": ["tiktok-live", "youtube-live"],
    "play_modes": ["SOLO", "KOL_LIVE"]
  }
}
